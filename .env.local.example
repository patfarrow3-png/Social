# ─── Instagram Graph API ─────────────────────────────────────────────────────
#
# Powers live profile stats and the "Live Posts" tab in Instagram Manager.
# Account @_trippygrippy_ must be a Business or Creator account on Instagram.
#
# Step-by-step setup:
#
#   1. Convert @_trippygrippy_ to a Business or Creator account
#      Instagram → Settings → Account → Switch to Professional Account
#
#   2. Create a Facebook Developer App
#      https://developers.facebook.com/apps/creation/
#      → Select "Business" type → Add product: "Instagram Graph API"
#
#   3. Connect your Instagram account to the app
#      App Dashboard → Instagram → API Setup with Instagram Business Login
#      → Add your Instagram account
#
#   4. Generate a long-lived access token (valid for 60 days, renewable)
#      Use the Graph API Explorer: https://developers.facebook.com/tools/explorer/
#      → Select your app → Generate User Access Token
#      → Permissions needed: instagram_basic, instagram_manage_insights, pages_show_list
#      Then exchange for a long-lived token:
#      GET https://graph.instagram.com/access_token
#        ?grant_type=ig_exchange_token
#        &client_id={app-id}
#        &client_secret={app-secret}
#        &access_token={short-lived-token}
#
#   5. Paste the long-lived token below and restart the dev server
#
# When this variable is absent, the dashboard shows placeholder stats and
# an empty Live Posts tab with setup instructions.

INSTAGRAM_ACCESS_TOKEN=your_long_lived_token_here


# ─── Metricool Integration ───────────────────────────────────────────────────
#
# Obtain your API token from:
#   Metricool → Settings → API → Generate Token
#
# Find your Blog ID in the same screen, or from the URL when viewing
# your brand's dashboard: app.metricool.com/brands/{BLOG_ID}/...
#
# When these variables are absent the analytics dashboard shows realistic
# mock data so you can develop and demo without an active Metricool account.

METRICOOL_API_TOKEN=your_token_here
METRICOOL_BLOG_ID=your_blog_id_here


# ─── RSS News Feeds ───────────────────────────────────────────────────────────
#
# Set to "true" to fetch live articles from the 10 configured RSS sources.
# When absent or "false", the News Consolidator uses built-in mock articles.

ENABLE_RSS=false
