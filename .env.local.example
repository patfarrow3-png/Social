# ─── Metricool Integration ───────────────────────────────────────────────────
#
# Obtain your API token from:
#   Metricool → Settings → API → Generate Token
#
# Find your Blog ID in the same screen, or from the URL when viewing
# your brand's dashboard: app.metricool.com/brands/{BLOG_ID}/...
#
# When these variables are absent the analytics dashboard shows realistic
# mock data so you can develop and demo without an active Metricool account.

METRICOOL_API_TOKEN=your_token_here
METRICOOL_BLOG_ID=your_blog_id_here
