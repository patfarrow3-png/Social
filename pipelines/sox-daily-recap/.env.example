# ── Required ────────────────────────────────────────────────────────────────────

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs API key — https://elevenlabs.io (Profile → API Key)
ELEVENLABS_API_KEY=...

# ElevenLabs voice ID for Henry (energetic son)
# Free pre-made suggestions:
#   Charlie  → IKne3meq5aSn9XLyUdCD  (young, upbeat)
#   Adam     → pNInz6obpgDQGcFmaJgB  (confident, energetic)
HENRY_VOICE_ID=IKne3meq5aSn9XLyUdCD

# ElevenLabs voice ID for Dad (old-school, dry)
# Free pre-made suggestions:
#   Bill     → pqHfZKP75CvOlQylNhV4  (deep, measured)
#   Arnold   → VR6AewLTigWG4xSOukaG  (older, gravelly)
DAD_VOICE_ID=pqHfZKP75CvOlQylNhV4

# ── Optional ─────────────────────────────────────────────────────────────────────

# ElevenLabs TTS model (default: eleven_turbo_v2_5)
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# Output folder (default: ~/Desktop/Sox Daily Recap)
# On Chromebook the Linux Desktop is accessible in Files → Linux files → Desktop
# Alternatively point to Downloads: /mnt/chromeos/MyFiles/Downloads/Sox Daily Recap
# OUTPUT_DIR=/mnt/chromeos/MyFiles/Downloads/Sox Daily Recap
